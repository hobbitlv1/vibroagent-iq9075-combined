+int32_t LlamaLlm::state_logits(
+    const geniex_LlmStateLogitsInput* input, geniex_LlmStateLogitsOutput* output) {
+    if (!input || input->struct_size < sizeof(geniex_LlmStateLogitsInput) || !output ||
+        output->struct_size < sizeof(geniex_LlmStateLogitsOutput) || !input->token_ids ||
+        input->token_ids_count <= 0) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    if (!this->ctx || !this->model) return GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+    std::memset(output, 0, sizeof(*output));
+    output->struct_size = sizeof(*output);
+
+    const auto row_it = this->logits_index.find(input->sequence_id);
+    if (!this->stateful_mode || row_it == this->logits_index.end()) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(this->model));
+    const float* row = llama_get_logits_ith(this->ctx, row_it->second);
+    if (!row) return GENIEX_ERROR_LLM_GENERATION_FAILED;
+
+    float* selected = static_cast<float*>(std::malloc(
+        static_cast<size_t>(input->token_ids_count) * sizeof(float)));
+    if (!selected) return GENIEX_ERROR_COMMON_MEMORY_ALLOCATION;
+    for (int32_t i = 0; i < input->token_ids_count; ++i) {
+        const int32_t token_id = input->token_ids[i];
+        if (token_id < 0 || token_id >= n_vocab) {
+            std::free(selected);
+            return GENIEX_ERROR_COMMON_INVALID_INPUT;
+        }
+        selected[i] = row[token_id];
+    }
+    output->logits = selected;
+    output->logits_count = input->token_ids_count;
+    return GENIEX_SUCCESS;
+}
