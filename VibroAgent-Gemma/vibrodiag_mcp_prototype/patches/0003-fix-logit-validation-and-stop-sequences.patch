diff --git a/sdk/plugins/llama_cpp/include/stop_output.h b/sdk/plugins/llama_cpp/include/stop_output.h
new file mode 100644
--- /dev/null
+++ b/sdk/plugins/llama_cpp/include/stop_output.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <algorithm>
+#include <string>
+
+#include "common.h"
+#include "geniex.h"
+
+namespace geniex {
+
+// Share stop handling between ordinary, speculative and stateful generation.
+// Keep only possible stop prefixes pending so callbacks never see a stop string.
+class StopOutput {
+    const geniex_GenerationConfig& config;
+    geniex_token_callback callback;
+    void* user_data;
+    std::string pending;
+
+    bool emit(size_t count) {
+        const std::string ready = pending.substr(0, count);
+        pending.erase(0, count);
+        if (ready.empty()) return true;
+        if (callback && !callback(ready.c_str(), user_data)) {
+            cancelled = true;
+            return false;
+        }
+        text += ready;
+        return true;
+    }
+
+public:
+    std::string text;
+    bool stopped = false;
+    bool cancelled = false;
+
+    StopOutput(const geniex_GenerationConfig& cfg, geniex_token_callback cb, void* data)
+        : config(cfg), callback(cb), user_data(data) {}
+
+    bool append(const std::string& piece) {
+        pending += piece;
+        size_t match = std::string::npos;
+        size_t ready = pending.size();
+        for (int32_t i = 0; i < config.stop_count; ++i) {
+            const char* stop = config.stop[i];
+            if (!stop || !*stop) continue;
+            match = std::min(match, pending.find(stop));
+            ready = std::min(ready, string_find_partial_stop(pending, stop));
+        }
+        if (match != std::string::npos) {
+            stopped = true;
+            emit(match);
+            pending.clear();
+            return false;
+        }
+        return emit(ready);
+    }
+
+    void finish() {
+        if (!stopped && !cancelled) emit(pending.size());
+    }
+};
+
+}  // namespace geniex
diff --git a/sdk/plugins/llama_cpp/tests/test_stop_output.cpp b/sdk/plugins/llama_cpp/tests/test_stop_output.cpp
new file mode 100644
--- /dev/null
+++ b/sdk/plugins/llama_cpp/tests/test_stop_output.cpp
@@ -0,0 +1,59 @@
+#include <cassert>
+#include <string>
+#include "stop_output.h"
+
+static bool collect(const char* piece, void* data) {
+    *static_cast<std::string*>(data) += piece;
+    return true;
+}
+
+int main() {
+    const char* stops[] = {"alpha beta", "END", nullptr, ""};
+    geniex_GenerationConfig cfg{};
+    cfg.stop = stops;
+    cfg.stop_count = 4;
+    std::string streamed;
+    geniex::StopOutput split(cfg, collect, &streamed);
+    assert(split.append("before al"));
+    assert(streamed == "before ");
+    assert(split.append("pha "));
+    assert(streamed == "before ");
+    assert(!split.append("beta after"));
+    split.finish();
+    assert(split.stopped && split.text == "before " && streamed == split.text);
+
+    geniex::StopOutput inside(cfg, nullptr, nullptr);
+    assert(!inside.append("ok END not visible"));
+    assert(inside.text == "ok ");
+
+    geniex::StopOutput partial(cfg, nullptr, nullptr);
+    assert(partial.append("ok al"));
+    partial.finish();
+    assert(!partial.stopped && partial.text == "ok al");
+
+    geniex::StopOutput mismatch(cfg, nullptr, nullptr);
+    assert(mismatch.append("al"));
+    assert(mismatch.append("pine"));
+    mismatch.finish();
+    assert(mismatch.text == "alpine");
+
+    geniex::StopOutput cancel(cfg, [](const char*, void*) { return false; }, nullptr);
+    assert(!cancel.append("visible"));
+    cancel.finish();
+    assert(cancel.cancelled && cancel.text.empty());
+
+    const char* overlaps[] = {"abcde", "bcd"};
+    cfg.stop = overlaps;
+    cfg.stop_count = 2;
+    geniex::StopOutput overlap(cfg, nullptr, nullptr);
+    assert(overlap.append("ab"));
+    assert(!overlap.append("cde"));
+    assert(overlap.text.empty());
+
+    cfg.stop = nullptr;
+    cfg.stop_count = 0;
+    geniex::StopOutput none(cfg, nullptr, nullptr);
+    assert(none.append(std::string(4096, 'x')));
+    none.finish();
+    assert(none.text == std::string(4096, 'x'));
+}
