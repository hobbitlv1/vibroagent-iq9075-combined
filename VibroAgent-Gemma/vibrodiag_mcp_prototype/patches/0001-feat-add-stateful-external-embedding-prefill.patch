+int32_t geniex_llm_decode(
+    geniex_LLM* h, const geniex_LlmBatch* batch, geniex_LlmDecodeOutput* output) {
+    if (!batch || batch->struct_size < sizeof(geniex_LlmBatch) || !output ||
+        output->struct_size < sizeof(geniex_LlmDecodeOutput)) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    std::memset(output, 0, sizeof(*output));
+    output->struct_size   = sizeof(*output);
+    output->next_position = -1;
+
+    try {
+        auto backend = reinterpret_cast<ILlm*>(h);
+        if (!backend) return GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+        int32_t result = backend->decode(batch, output);
+        calculate_profile_data(output->profile_data);
+        return result;
+    } catch (const std::exception& e) {
+        GENIEX_LOG_ERROR("llm decode error: {}", e.what());
+        return GENIEX_ERROR_COMMON_UNKNOWN;
+    }
+}
+
+int32_t geniex_llm_generate_from_state(geniex_LLM* h,
+    const geniex_LlmGenerateFromStateInput* input, geniex_LlmGenerateOutput* output) {
+    if (!input || input->struct_size < sizeof(geniex_LlmGenerateFromStateInput) || !output) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    std::memset(output, 0, sizeof(*output));
+
+    try {
+        auto backend = reinterpret_cast<ILlm*>(h);
+        if (!backend) return GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+
+        std::unique_ptr<Utf8CallbackWrapper> wrapper;
+        geniex_LlmGenerateFromStateInput      modified_input;
+        int32_t                               result;
+        if (input->on_token) {
+            wrapper                     = std::make_unique<Utf8CallbackWrapper>();
+            wrapper->original_callback  = input->on_token;
+            wrapper->original_user_data = input->user_data;
+            modified_input              = *input;
+            modified_input.on_token     = get_utf8_callback_wrapper();
+            modified_input.user_data    = wrapper.get();
+            result = backend->generate_from_state(&modified_input, output);
+            wrapper->flush();
+        } else {
+            result = backend->generate_from_state(input, output);
+        }
+        calculate_profile_data(output->profile_data);
+        return result;
+    } catch (const std::exception& e) {
+        GENIEX_LOG_ERROR("llm generate from state error: {}", e.what());
+        return GENIEX_ERROR_COMMON_UNKNOWN;
+    }
+}
