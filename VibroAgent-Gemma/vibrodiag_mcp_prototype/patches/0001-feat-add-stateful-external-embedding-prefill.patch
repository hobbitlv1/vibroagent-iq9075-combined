+def _marshal_input_embd(input_embd) -> tuple[object, int, int]:
+    try:
+        rows = list(input_embd)
+    except TypeError as exc:
+        raise TypeError('input_embd must be a 2D iterable') from exc
+    if not rows:
+        raise ValueError('input_embd must not be empty')
+    flat: list[float] = []
+    width = None
+    for row_index, row in enumerate(rows):
+        try:
+            values = list(row)
+        except TypeError as exc:
+            raise TypeError(f'input_embd row {row_index} must be iterable') from exc
+        if width is None:
+            width = len(values)
+            if width == 0:
+                raise ValueError('input_embd rows must not be empty')
+        elif len(values) != width:
+            raise ValueError('input_embd must be rectangular')
+        for column_index, raw in enumerate(values):
+            try:
+                value = c_float(float(raw)).value
+            except (TypeError, ValueError, OverflowError) as exc:
+                raise TypeError(f'input_embd[{row_index}][{column_index}] must be numeric') from exc
+            if not math.isfinite(value):
+                raise ValueError(f'input_embd[{row_index}][{column_index}] must be finite')
+            flat.append(value)
+    assert width is not None
+    return (c_float * len(flat))(*flat), len(rows), width
+
+
+def _marshal_input_ids(input_ids) -> tuple[object, int]:
+    try:
+        raw_values = list(input_ids)
+    except TypeError as exc:
+        raise TypeError('input_ids must be an iterable of integers') from exc
+    if not raw_values:
+        raise ValueError('input_ids must not be empty')
+    values: list[int] = []
+    for index, raw in enumerate(raw_values):
+        try:
+            value = operator.index(raw)
+        except TypeError as exc:
+            raise TypeError(f'input_ids[{index}] must be an integer') from exc
+        if value < 0 or value > 0x7FFFFFFF:
+            raise ValueError(f'input_ids[{index}] is outside the non-negative int32 range')
+        values.append(value)
+    return (c_int32 * len(values))(*values), len(values)
+
+
 def _build_sampler(
     temperature: float,
     top_p: float,
@@ -286,6 +349,81 @@ class GenieXLLM:
         streamer.start(_run)
         return streamer

+    def decode(self, *, input_ids=None, input_embd=None) -> DecodeOutput:
+        """Append one token or raw-embedding batch to the retained KV state."""
+        if (input_ids is None) == (input_embd is None):
+            raise ValueError('decode requires exactly one of input_ids or input_embd')
+
+        token_arr = None
+        embd_arr = None
+        embd_dim = 0
+        if input_ids is not None:
+            token_arr, n_tokens = _marshal_input_ids(input_ids)
+        else:
+            embd_arr, n_tokens, embd_dim = _marshal_input_embd(input_embd)
+
+        batch = geniex_LlmBatch(
+            struct_size=sizeof(geniex_LlmBatch),
+            n_tokens=n_tokens,
+            embd_dim=embd_dim,
+        )
+        if token_arr is not None:
+            batch.token = token_arr
+        if embd_arr is not None:
+            batch.embd = embd_arr
+        out = geniex_LlmDecodeOutput(struct_size=sizeof(geniex_LlmDecodeOutput))
+        _check(get_llm_decode_function()(self._handle, byref(batch), byref(out)))
+        profile = _apply_meta(ProfileData.from_c(out.profile_data), self._meta)
+        return DecodeOutput(out.n_decoded, out.next_position, profile)
+
+    prefill = decode
+
+    def generate_from_state(
+        self,
+        *,
+        sequence_id: int = 0,
+        max_new_tokens: int = 512,
+        temperature: float = 0.0,
+        top_p: float = 0.0,
+        top_k: int = 0,
+        min_p: float = 0.0,
+        repetition_penalty: float = 0.0,
+        presence_penalty: float = 0.0,
+        frequency_penalty: float = 0.0,
+        seed: int = 0,
+        stop: list[str] | None = None,
+        grammar: str | None = None,
+    ) -> GenerateOutput:
+        """Generate from the latest logits produced by :meth:`decode`."""
+        sequence_id = operator.index(sequence_id)
+        if sequence_id < 0 or sequence_id > 0x7FFFFFFF:
+            raise ValueError('sequence_id must be in the non-negative int32 range')
+        sampler = _build_sampler(
+            temperature, top_p, top_k, min_p, repetition_penalty,
+            presence_penalty, frequency_penalty, seed, grammar,
+        )
+        cfg, stop_arr, image_arr, audio_arr = _build_gen_config(
+            max_new_tokens, stop or [], sampler, [], []
+        )
+        inp = geniex_LlmGenerateFromStateInput(
+            struct_size=sizeof(geniex_LlmGenerateFromStateInput),
+            config=pointer(cfg),
+            sequence_id=sequence_id,
+        )
+        out = geniex_LlmGenerateOutput()
+        lib = load_library()
+        rc = get_llm_generate_from_state_function()(self._handle, byref(inp), byref(out))
+        full = _decode_utf8(out.full_text)
+        profile = _apply_meta(ProfileData.from_c(out.profile_data), self._meta)
+        if out.full_text:
+            lib.geniex_free(out.full_text)
+        _keep = (sampler, cfg, stop_arr, image_arr, audio_arr)
+        if rc == GENIEX_ERROR_LLM_TOKENIZATION_CONTEXT_LENGTH:
+            profile.stop_reason = 'context_length'
+            return GenerateOutput.from_raw(full, profile)
+        _check(rc)
+        return GenerateOutput.from_raw(full, profile)
+
     def reset(self) -> None:
         """Clear KV cache and reset sampler state."""
         lib = load_library()
diff --git a/bindings/python/tests/unit/test_stateful_decode.py b/bindings/python/tests/unit/test_stateful_decode.py
