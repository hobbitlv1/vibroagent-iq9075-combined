+int32_t LlamaLlm::decode(const geniex_LlmBatch* input, geniex_LlmDecodeOutput* output) {
+    if (!input || input->struct_size < sizeof(geniex_LlmBatch) || !output ||
+        output->struct_size < sizeof(geniex_LlmDecodeOutput)) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    if (!this->ctx || !this->model) return GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+
+    std::memset(output, 0, sizeof(*output));
+    output->struct_size   = sizeof(*output);
+    output->next_position = -1;
+
+    const bool has_tokens = input->token != nullptr;
+    const bool has_embd   = input->embd != nullptr;
+    if (has_tokens == has_embd || input->n_tokens <= 0) {
+        GENIEX_LOG_ERROR("decode requires exactly one non-empty token or embd input");
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    if (static_cast<uint32_t>(input->n_tokens) > llama_n_batch(this->ctx)) {
+        GENIEX_LOG_ERROR("decode batch size {} exceeds n_batch {}", input->n_tokens, llama_n_batch(this->ctx));
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+
+    const llama_vocab* vocab = llama_model_get_vocab(this->model);
+    if (has_tokens) {
+        if (input->embd_dim != 0) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+        const int32_t vocab_size = llama_vocab_n_tokens(vocab);
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            if (input->token[i] < 0 || input->token[i] >= vocab_size) {
+                GENIEX_LOG_ERROR("decode token ID out of range at row {}: {}", i, input->token[i]);
+                return GENIEX_ERROR_COMMON_INVALID_INPUT;
+            }
+        }
+    } else {
+        const int32_t n_embd = llama_model_n_embd_inp(this->model);
+        if (input->embd_dim != n_embd) {
+            GENIEX_LOG_ERROR("decode embd width mismatch: got {}, model requires {}", input->embd_dim, n_embd);
+            return GENIEX_ERROR_COMMON_INVALID_INPUT;
+        }
+        const size_t rows  = static_cast<size_t>(input->n_tokens);
+        const size_t width = static_cast<size_t>(input->embd_dim);
+        if (rows > std::numeric_limits<size_t>::max() / width) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+        for (size_t i = 0; i < rows * width; ++i) {
+            if (!std::isfinite(input->embd[i])) {
+                GENIEX_LOG_ERROR("decode embd contains a non-finite value at flat index {}", i);
+                return GENIEX_ERROR_COMMON_INVALID_INPUT;
+            }
+        }
+    }
+
+    if (input->pos) {
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            if (input->pos[i] < 0) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+        }
+    }
+
+    const bool has_n_seq_id = input->n_seq_id != nullptr;
+    const bool has_seq_id   = input->seq_id != nullptr;
+    if (has_n_seq_id != has_seq_id) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    const uint32_t context_n_seq_max = llama_n_seq_max(this->ctx);
+    if (has_seq_id) {
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            if (!input->seq_id[i] || input->n_seq_id[i] <= 0 ||
+                static_cast<uint32_t>(input->n_seq_id[i]) > context_n_seq_max) {
+                return GENIEX_ERROR_COMMON_INVALID_INPUT;
+            }
+            for (int32_t j = 0; j < input->n_seq_id[i]; ++j) {
+                const int32_t seq = input->seq_id[i][j];
+                if (seq < 0 || static_cast<uint32_t>(seq) >= context_n_seq_max) {
+                    return GENIEX_ERROR_COMMON_INVALID_INPUT;
+                }
+            }
+        }
+    }
+
+    std::vector<llama_seq_id*> seq_id_rows;
+    if (has_seq_id) {
+        seq_id_rows.resize(input->n_tokens);
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            seq_id_rows[i] = const_cast<llama_seq_id*>(
+                reinterpret_cast<const llama_seq_id*>(input->seq_id[i]));
+        }
+    }
+
+    llama_batch batch{};
+    batch.n_tokens = input->n_tokens;
+    batch.token = has_tokens
+                      ? const_cast<llama_token*>(reinterpret_cast<const llama_token*>(input->token))
+                      : nullptr;
+    batch.embd = has_embd ? const_cast<float*>(input->embd) : nullptr;
+    batch.pos = input->pos ? const_cast<llama_pos*>(reinterpret_cast<const llama_pos*>(input->pos)) : nullptr;
+    batch.n_seq_id = has_n_seq_id ? const_cast<int32_t*>(input->n_seq_id) : nullptr;
+    batch.seq_id = seq_id_rows.empty() ? nullptr : seq_id_rows.data();
+    batch.logits = input->logits ? const_cast<int8_t*>(input->logits) : nullptr;
+
+    ::common::Profiler profiler;
+    profiler.prompt_start();
+    const int rc = llama_decode(this->ctx, batch);
+    profiler.prompt_end();
+    if (rc != 0) {
+        profiler.update_prompt_tokens(0);
+        profiler.to_profile_data(output->profile_data);
+        return rc == 1 ? GENIEX_ERROR_LLM_TOKENIZATION_CONTEXT_LENGTH : GENIEX_ERROR_LLM_GENERATION_FAILED;
+    }
+
+    if (!this->stateful_mode) {
+        this->sampler_history.clear();
+        auto& history = this->sampler_history[0];
+        history.reserve(this->past_prompt_tokens.size());
+        for (llama_token token : this->past_prompt_tokens) history.push_back({token, false});
+    }
+    this->stateful_mode = true;
+
+    auto for_each_sequence = [&](int32_t row, const auto& fn) {
+        if (!has_seq_id) {
+            fn(static_cast<llama_seq_id>(0));
+            return;
+        }
+        for (int32_t j = 0; j < input->n_seq_id[row]; ++j) {
+            fn(static_cast<llama_seq_id>(input->seq_id[row][j]));
+        }
+    };
+    if (has_tokens) {
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            for_each_sequence(i, [&](llama_seq_id seq) {
+                this->sampler_history[seq].push_back({static_cast<llama_token>(input->token[i]), false});
+            });
+        }
+    }
+
+    this->logits_index.clear();
+    if (input->logits) {
+        for (int32_t i = 0; i < input->n_tokens; ++i) {
+            if (input->logits[i]) {
+                for_each_sequence(i, [&](llama_seq_id seq) { this->logits_index[seq] = i; });
+            }
+        }
+    } else {
+        const int32_t i = input->n_tokens - 1;
+        for_each_sequence(i, [&](llama_seq_id seq) { this->logits_index[seq] = i; });
+    }
+
+    this->n_past_global = 0;
+    this->past_prompt_tokens.clear();
+    const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(this->ctx), 0);
+    this->n_past = pos_max >= 0 ? static_cast<int>(pos_max + 1) : 0;
+    output->n_decoded = input->n_tokens;
+    output->next_position = pos_max >= 0 ? static_cast<int32_t>(pos_max + 1) : -1;
+    profiler.update_prompt_tokens(static_cast<uint32_t>(input->n_tokens));
+    profiler.set_stop_reason(::common::StopReason::GENIEX_STOP_REASON_COMPLETED);
+    profiler.to_profile_data(output->profile_data);
+    return GENIEX_SUCCESS;
+}
