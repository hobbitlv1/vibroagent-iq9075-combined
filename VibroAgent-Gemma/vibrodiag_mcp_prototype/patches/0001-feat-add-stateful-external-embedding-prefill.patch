+int32_t LlamaLlm::generate_from_state(
+    const geniex_LlmGenerateFromStateInput* input, geniex_LlmGenerateOutput* output) {
+    if (!input || input->struct_size < sizeof(geniex_LlmGenerateFromStateInput) || !output) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    if (!this->ctx || !this->model) return GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+    std::memset(output, 0, sizeof(*output));
+
+    if (!this->stateful_mode || input->sequence_id < 0 ||
+        static_cast<uint32_t>(input->sequence_id) >= llama_n_seq_max(this->ctx)) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    auto logits_it = this->logits_index.find(input->sequence_id);
+    if (logits_it == this->logits_index.end()) {
+        GENIEX_LOG_ERROR("generate_from_state requires logits for sequence {}", input->sequence_id);
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+
+    llama_pos next_position = llama_memory_seq_pos_max(llama_get_memory(this->ctx), input->sequence_id);
+    if (next_position < 0) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    ++next_position;
+
+    geniex_GenerationConfig cfg = input->config ? *input->config : geniex_GenerationConfig{};
+    if (cfg.stop_count < 0 || (cfg.stop_count > 0 && !cfg.stop)) return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    cfg.max_tokens = cfg.max_tokens > 0 ? cfg.max_tokens : 128;
+
+    this->set_sampler(cfg.sampler_config);
+    if (!this->sampler) return GENIEX_ERROR_COMMON_MEMORY_ALLOCATION;
+    auto history_it = this->sampler_history.find(input->sequence_id);
+    if (history_it != this->sampler_history.end()) {
+        for (const auto& entry : history_it->second) {
+            common_sampler_accept(this->sampler, entry.token, entry.generated);
+        }
+    }
+
+    const llama_vocab* vocab = llama_model_get_vocab(this->model);
+    ::common::Profiler profiler;
+    profiler.decode_start();
+    int32_t res = GENIEX_SUCCESS;
+    int32_t sample_index = logits_it->second;
+    bool first_token_generated = false;
+    std::vector<llama_token> generated_tokens;
+    std::stringstream full_text;
+
+    while (res == GENIEX_SUCCESS && static_cast<int32_t>(generated_tokens.size()) < cfg.max_tokens) {
+        const llama_token id = common_sampler_sample(this->sampler, this->ctx, sample_index);
+        common_sampler_accept(this->sampler, id, true);
+        if (!first_token_generated) {
+            profiler.record_ttft();
+            first_token_generated = true;
+        }
+        if (llama_vocab_is_eog(vocab, id)) {
+            profiler.set_stop_reason(::common::StopReason::GENIEX_STOP_REASON_EOS);
+            break;
+        }
+
+        char token_buf[64];
+        int n = llama_token_to_piece(vocab, id, token_buf, sizeof(token_buf) - 1, 0, this->allow_special_tokens);
+        if (n < 0) {
+            res = GENIEX_ERROR_LLM_GENERATION_FAILED;
+            break;
+        }
+        token_buf[n] = '\0';
+        const bool stop_matched = cfg.stop_count > 0 && std::any_of(
+            cfg.stop, cfg.stop + cfg.stop_count,
+            [&](const char* s) { return s && std::strcmp(token_buf, s) == 0; });
+        if (stop_matched) {
+            profiler.set_stop_reason(::common::StopReason::GENIEX_STOP_REASON_STOP_SEQUENCE);
+            break;
+        }
+
+        generated_tokens.push_back(id);
+        if (input->on_token && !input->on_token(token_buf, input->user_data)) {
+            profiler.set_stop_reason(::common::StopReason::GENIEX_STOP_REASON_USER);
+            break;
+        }
+        full_text << token_buf;
+
+        llama_token token = id;
+        llama_pos position = next_position;
+        int32_t n_seq_id = 1;
+        llama_seq_id sequence = input->sequence_id;
+        llama_seq_id* sequences = &sequence;
+        int8_t want_logits = 1;
+        llama_batch batch{};
+        batch.n_tokens = 1;
+        batch.token = &token;
+        batch.pos = &position;
+        batch.n_seq_id = &n_seq_id;
+        batch.seq_id = &sequences;
+        batch.logits = &want_logits;
+
+        const int rc = llama_decode(this->ctx, batch);
+        if (rc != 0) {
+            this->logits_index.clear();
+            res = rc == 1 ? GENIEX_ERROR_LLM_TOKENIZATION_CONTEXT_LENGTH : GENIEX_ERROR_LLM_GENERATION_FAILED;
+            break;
+        }
+        ++next_position;
+        this->sampler_history[input->sequence_id].push_back({id, true});
+        this->logits_index.clear();
+        this->logits_index[input->sequence_id] = 0;
+        sample_index = 0;
+        if (input->sequence_id == 0) this->n_past = static_cast<int>(next_position);
+    }
+
+    if (res == GENIEX_ERROR_LLM_TOKENIZATION_CONTEXT_LENGTH ||
+        static_cast<int32_t>(generated_tokens.size()) >= cfg.max_tokens) {
+        profiler.set_stop_reason(::common::StopReason::GENIEX_STOP_REASON_LENGTH);
+    }
+    profiler.decode_end();
+    profiler.update_generated_tokens(static_cast<uint32_t>(generated_tokens.size()));
+    profiler.to_profile_data(output->profile_data);
+    output->full_text = strdup(full_text.str().c_str());
+    return output->full_text ? res : GENIEX_ERROR_COMMON_MEMORY_ALLOCATION;
+}
