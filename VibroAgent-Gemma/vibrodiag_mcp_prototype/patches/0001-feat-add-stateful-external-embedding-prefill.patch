@@ -575,6 +575,47 @@ typedef struct {
 GENIEX_API int32_t geniex_llm_generate(
     geniex_LLM* handle, const geniex_LlmGenerateInput* input, geniex_LlmGenerateOutput* output);

+/* ====================  Stateful Batch Decode  ============================ */
+
+/** A llama.cpp-style token or raw-embedding batch. Exactly one of token and
+ * embd must be non-NULL. Buffers are borrowed for the duration of the call. */
+typedef struct {
+    uint32_t struct_size; /** Initialize to sizeof(geniex_LlmBatch). */
+    int32_t  n_tokens;
+    const int32_t* token;
+    const float*   embd;      /** Row-major [n_tokens, embd_dim]. */
+    int32_t        embd_dim;  /** Zero for token batches. */
+    const int32_t*        pos;
+    const int32_t*        n_seq_id;
+    const int32_t* const* seq_id;
+    const int8_t*         logits;
+} geniex_LlmBatch;
+
+typedef struct {
+    uint32_t           struct_size; /** Initialize to sizeof(geniex_LlmDecodeOutput). */
+    int32_t            n_decoded;
+    int32_t            next_position;
+    int32_t            reserved0;
+    geniex_ProfileData profile_data;
+} geniex_LlmDecodeOutput;
+
+/** Decode one token or embedding batch and retain its KV-cache state. */
+GENIEX_API int32_t geniex_llm_decode(
+    geniex_LLM* handle, const geniex_LlmBatch* batch, geniex_LlmDecodeOutput* output);
+
+typedef struct {
+    uint32_t                       struct_size; /** Initialize to sizeof(geniex_LlmGenerateFromStateInput). */
+    const geniex_GenerationConfig* config;
+    geniex_token_callback          on_token;
+    void*                          user_data;
+    int32_t                        sequence_id;
+    int32_t                        reserved0;
+} geniex_LlmGenerateFromStateInput;
+
+/** Generate from logits/KV state produced by geniex_llm_decode. */
+GENIEX_API int32_t geniex_llm_generate_from_state(geniex_LLM* handle,
+    const geniex_LlmGenerateFromStateInput* input, geniex_LlmGenerateOutput* output);
+
 /* ====================  Model Metadata  =================================== */

 /** Static, plugin-reported metadata about the loaded LLM. All fields are
