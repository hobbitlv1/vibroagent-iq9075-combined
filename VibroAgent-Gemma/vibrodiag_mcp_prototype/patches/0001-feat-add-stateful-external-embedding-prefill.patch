index 0000000..8a55ee6
--- /dev/null
+++ b/sdk/compat/llm_stateful_bridge.cpp
@@ -0,0 +1,44 @@
+// Copyright (c) 2024-2026 Qualcomm Technologies, Inc. and/or its subsidiaries.
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Dispatch the append-only stateful API through an official core that predates
+// these exports. A fully rebuilt core exports the same functions directly.
+
+#include <cstring>
+#include <exception>
+
+#include "geniex.h"
+#include "plugin/ILlm.h"
+
+using namespace geniex;
+
+extern "C" int32_t geniex_llm_decode(
+    geniex_LLM* handle, const geniex_LlmBatch* batch, geniex_LlmDecodeOutput* output) {
+    if (!batch || batch->struct_size < sizeof(geniex_LlmBatch) || !output ||
+        output->struct_size < sizeof(geniex_LlmDecodeOutput)) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    std::memset(output, 0, sizeof(*output));
+    output->struct_size = sizeof(*output);
+    output->next_position = -1;
+    try {
+        auto* backend = reinterpret_cast<ILlm*>(handle);
+        return backend ? backend->decode(batch, output) : GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+    } catch (const std::exception&) {
+        return GENIEX_ERROR_COMMON_UNKNOWN;
+    }
+}
+
+extern "C" int32_t geniex_llm_generate_from_state(geniex_LLM* handle,
+    const geniex_LlmGenerateFromStateInput* input, geniex_LlmGenerateOutput* output) {
+    if (!input || input->struct_size < sizeof(geniex_LlmGenerateFromStateInput) || !output) {
+        return GENIEX_ERROR_COMMON_INVALID_INPUT;
+    }
+    std::memset(output, 0, sizeof(*output));
+    try {
+        auto* backend = reinterpret_cast<ILlm*>(handle);
+        return backend ? backend->generate_from_state(input, output) : GENIEX_ERROR_COMMON_NOT_INITIALIZED;
+    } catch (const std::exception&) {
+        return GENIEX_ERROR_COMMON_UNKNOWN;
+    }
+}
diff --git a/sdk/include/geniex.h b/sdk/include/geniex.h
index 5d67ef4..eb64b95 100644
