index 0000000..2d530d5
--- /dev/null
+++ b/bindings/python/tests/unit/test_stateful_decode.py
@@ -0,0 +1,65 @@
+from ctypes import POINTER, c_void_p, cast, create_string_buffer, sizeof
+
+import pytest
+
+import geniex.modeling as modeling
+from geniex._ffi._types import (
+    geniex_LlmBatch,
+    geniex_LlmDecodeOutput,
+    geniex_LlmGenerateFromStateInput,
+    geniex_LlmGenerateOutput,
+)
+from geniex.modeling import GenieXLLM
+
+
+def test_stateful_embedding_decode_and_generation(monkeypatch):
+    assert sizeof(geniex_LlmBatch) == 64
+    assert sizeof(geniex_LlmDecodeOutput) == 96
+    assert sizeof(geniex_LlmGenerateFromStateInput) == 40
+    payload = create_string_buffer(b" continued")
+    seen = {}
+
+    class Core:
+        def geniex_llm_decode(self, _handle, batch_ptr, output_ptr):
+            batch = cast(batch_ptr, POINTER(geniex_LlmBatch)).contents
+            seen["embd"] = list(batch.embd[: batch.n_tokens * batch.embd_dim])
+            output = cast(output_ptr, POINTER(geniex_LlmDecodeOutput)).contents
+            output.n_decoded = batch.n_tokens
+            output.next_position = 2
+            return 0
+
+        def geniex_llm_generate_from_state(self, _handle, input_ptr, output_ptr):
+            inp = cast(input_ptr, POINTER(geniex_LlmGenerateFromStateInput)).contents
+            seen["sequence_id"] = inp.sequence_id
+            output = cast(output_ptr, POINTER(geniex_LlmGenerateOutput)).contents
+            output.full_text = cast(payload, c_void_p)
+            return 0
+
+        def geniex_free(self, _pointer):
+            pass
+
+    core = Core()
+    monkeypatch.setattr(modeling, "load_library", lambda: core)
+    monkeypatch.setattr(modeling, "get_llm_decode_function", lambda: core.geniex_llm_decode)
+    monkeypatch.setattr(
+        modeling,
+        "get_llm_generate_from_state_function",
+        lambda: core.geniex_llm_generate_from_state,
+    )
+    model = GenieXLLM(c_void_p(123))
+    decoded = model.decode(input_embd=[[1, 2, 3], [4, 5, 6]])
+    generated = model.generate_from_state(sequence_id=0, max_new_tokens=4)
+    model._handle = None
+
+    assert decoded.n_decoded == 2
+    assert decoded.next_position == 2
+    assert seen == {"embd": pytest.approx([1, 2, 3, 4, 5, 6]), "sequence_id": 0}
+    assert generated.text == " continued"
+
+
+@pytest.mark.parametrize("rows", [[], [[1], [2, 3]], [[float("nan")]]])
+def test_stateful_embedding_decode_rejects_invalid_rows(rows):
+    model = GenieXLLM(c_void_p(123))
+    with pytest.raises(ValueError):
+        model.decode(input_embd=rows)
+    model._handle = None
diff --git a/sdk/compat/llm_stateful_bridge.cpp b/sdk/compat/llm_stateful_bridge.cpp
