# Top-level requirements of every environment the VibroAgent-Codec setup scripts create.
# constraints/codec.txt is compiled from this file and pins the full dependency closure, so a
# fresh install resolves to the same versions every time instead of whatever is newest that day.
#
# Regenerate (then re-run the test suites and examples/selftest.py before committing):
#   uv pip compile constraints/codec.in --universal --python-version 3.11 \
#       --no-header --no-emit-package geniex \
#       -o constraints/codec.txt

